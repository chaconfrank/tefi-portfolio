---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import skills from '../data/skills.json';

const proyectos = (await getCollection('proyectos', ({ data }) => !data.borrador)).sort(
  (a, b) => a.data.orden - b.data.orden || b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
---

<BaseLayout>
  <Hero />

  <section id="proyectos" class="py-8">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-sm font-medium tracking-wide text-ink-soft uppercase">Case studies</h2>
      <a href="/proyectos/" class="text-sm text-accent hover:underline">Ver todos →</a>
    </div>

    <div class="mt-6 grid gap-5">
      {proyectos.map((proyecto) => <CaseStudyCard proyecto={proyecto} />)}
    </div>
  </section>

  <section class="py-10">
    <h2 class="text-sm font-medium tracking-wide text-ink-soft uppercase">Sobre mí</h2>
    <div class="mt-5 max-w-2xl space-y-4">
      <p class="text-lg text-pretty">
        Diseñadora de producto con más de 2 años especializada en soluciones SaaS
        accesibles y centradas en el usuario.
      </p>
      <p class="text-pretty text-ink-soft">
        He llevado iniciativas de diseño de la concepción al lanzamiento en gestión
        de eventos, herramientas de proyectos y control de calidad, y turismo
        inclusivo. Sistemas de diseño, accesos por roles y accesibilidad: productos
        que funcionan y además son equitativos.
      </p>
      <p>
        <a href="/sobre-mi/" class="text-sm text-accent hover:underline">Más sobre cómo trabajo →</a>
      </p>
    </div>

    <dl class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        skills.map(({ categoria, items }) => (
          <div>
            <dt class="text-sm font-medium">{categoria}</dt>
            <dd class="mt-2 text-sm text-pretty text-ink-soft">{items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <ContactCTA />
</BaseLayout>
