---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SkillList from '../components/SkillList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import experiencia from '../data/experiencia.json';

const destacados = (await getCollection('proyectos', ({ data }) => !data.borrador && data.destacado))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <Hero />

  <section class="py-8">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-medium tracking-wide text-ink-soft uppercase">Proyectos destacados</h2>
      <a href="/proyectos" class="text-sm text-accent hover:underline">Ver todos →</a>
    </div>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {destacados.map((proyecto) => <ProjectCard proyecto={proyecto} />)}
    </div>
  </section>

  <SkillList />

  <section class="py-8">
    <h2 class="text-sm font-medium tracking-wide text-ink-soft uppercase">Experiencia</h2>
    <ol class="mt-5 space-y-6 border-l border-line pl-6">
      {
        experiencia.map((item) => (
          <li class="relative">
            <span class="absolute top-2 -left-[27px] size-2.5 rounded-full border-2 border-paper bg-accent" />
            <p class="text-xs text-ink-soft">{item.periodo}</p>
            <h3 class="mt-0.5 font-medium">
              {item.puesto} · <span class="text-ink-soft">{item.empresa}</span>
            </h3>
            <p class="mt-1 text-sm text-pretty text-ink-soft">{item.descripcion}</p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
