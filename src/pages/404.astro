---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Esta página no existe.">
  <section class="flex flex-col items-start py-24">
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Esta página no existe</h1>
    <p class="mt-3 text-ink-soft">Puede que el enlace esté roto o que la haya movido.</p>
    <a href="/" class="mt-8 rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90">
      Volver al inicio
    </a>
  </section>
</BaseLayout>
