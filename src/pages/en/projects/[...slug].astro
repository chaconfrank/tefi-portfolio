---
import { render } from 'astro:content';
import { getProyectos, slugDe } from '../../../i18n';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';

export const getStaticPaths = (async () => {
  // Los case studies en inglés (src/content/proyectos/en/), en /en/projects/.
  const proyectos = await getProyectos('en');

  return proyectos.map((proyecto, i) => ({
    params: { slug: slugDe(proyecto) },
    // El siguiente en el orden del listado, y vuelta al primero al final:
    // así nunca se llega a un callejón sin salida.
    props: { proyecto, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { proyecto, siguiente } = Astro.props;
const { Content } = await render(proyecto);
// Las dos plantillas reciben las mismas props: sólo cambia quién maqueta el cuerpo.
const Layout = proyecto.data.plantilla === 'editorial' ? CaseStudyLayout : ProjectLayout;
---

<Layout proyecto={proyecto} siguiente={siguiente}>
  <Content />
</Layout>
