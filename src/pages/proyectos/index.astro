---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectFan from '../../components/ProjectFan.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const proyectos = (await getCollection('proyectos', ({ data }) => !data.borrador)).sort(
  (a, b) => a.data.orden - b.data.orden || b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
---

<BaseLayout
  title="Proyectos"
  description="Tres case studies de producto: el problema, el proceso, mi rol y el impacto."
>
  <section class="py-12">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Proyectos</h1>
    <!-- Las negritas marcan lo que un recruiter tiene que retener del vistazo. -->
    <p class="mt-3 text-lg text-pretty text-ink-soft">
      Una colección de proyectos centrados en <strong class="font-semibold text-ink">resolver
      problemas reales</strong>, convirtiendo <strong class="font-semibold text-ink">flujos de
      trabajo complejos</strong> en productos digitales <strong class="font-semibold text-ink">sencillos,
      escalables y accesibles</strong>.
    </p>

    <div class="mt-6">
      <ProjectFan proyectos={proyectos} etiqueta="Proyectos" />
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
