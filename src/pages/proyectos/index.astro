---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const proyectos = (await getCollection('proyectos', ({ data }) => !data.borrador)).sort(
  (a, b) => a.data.orden - b.data.orden || b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
---

<BaseLayout
  title="Proyectos"
  description="Tres case studies de producto: el problema, el proceso, mi rol y el impacto."
>
  <section class="py-12">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Proyectos</h1>
    <p class="mt-3 text-pretty text-ink-soft">
      Tres case studies contados igual: qué problema había, cómo lo abordé, qué
      hice yo exactamente y qué cambió después.
    </p>

    <div class="mt-10 grid gap-5">
      {proyectos.map((proyecto) => <CaseStudyCard proyecto={proyecto} />)}
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
