---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIALS } from '../consts';
---

<BaseLayout title="Contacto" description="Hablemos: correo y redes.">
  <section class="py-12">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contacto</h1>
    <p class="mt-3 max-w-lg text-pretty text-ink-soft">
      ¿Tienes un proyecto en mente o quieres charlar? Escríbeme, respondo en 1-2 días.
    </p>

    <ul class="mt-8 space-y-2">
      {
        SOCIALS.map(({ href, label }) => (
          <li>
            <a class="text-accent hover:underline" href={href} target="_blank" rel="noopener">
              {label} ↗
            </a>
          </li>
        ))
      }
    </ul>

    <!--
      Para un formulario real necesitas un endpoint: servicio externo
      (Formspree, Web3Forms) o `output: 'server'` + un adaptador y
      un endpoint en src/pages/api/contacto.ts
    -->
  </section>
</BaseLayout>
