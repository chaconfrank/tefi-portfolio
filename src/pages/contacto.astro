---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL, LINKEDIN, CV_PATH, UBICACION, BUSCANDO_TRABAJO, DISPONIBILIDAD } from '../consts';

const canales = [
  { etiqueta: 'Email', valor: EMAIL, href: `mailto:${EMAIL}`, externo: false },
  { etiqueta: 'LinkedIn', valor: LINKEDIN.replace(/^https?:\/\/(www\.)?|\/$/g, ''), href: LINKEDIN, externo: true },
];
---

<BaseLayout title="Contacto" description="Email, LinkedIn y CV en PDF.">
  <section class="py-12">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contacto</h1>
    <p class="mt-3 max-w-lg text-pretty text-ink-soft">
      La vía más rápida es el email: respondo en 1-2 días.
    </p>

    {
      BUSCANDO_TRABAJO && (
        <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-line bg-paper-soft px-3 py-1 text-xs text-ink-soft">
          <span class="size-2 rounded-full bg-emerald-500" />
          {DISPONIBILIDAD} · {UBICACION}
        </p>
      )
    }

    <dl class="mt-10 divide-y divide-line border-y border-line">
      {
        canales.map(({ etiqueta, valor, href, externo }) => (
          <div class="flex items-baseline justify-between gap-4 py-4">
            <dt class="text-sm text-ink-soft">{etiqueta}</dt>
            <dd>
              <a
                class="text-accent hover:underline"
                href={href}
                target={externo ? '_blank' : undefined}
                rel={externo ? 'noopener' : undefined}
              >
                {valor}
                {externo && ' ↗'}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>

    <a
      href={CV_PATH}
      class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:opacity-90"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
      </svg>
      Descargar CV (PDF)
    </a>

    <!--
      Para un formulario real necesitas un endpoint: servicio externo
      (Formspree, Web3Forms) o `output: 'server'` + un adaptador y
      un endpoint en src/pages/api/contacto.ts
    -->
  </section>
</BaseLayout>
