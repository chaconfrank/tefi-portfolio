---
import { EMAIL, LINKEDIN, SITE_AUTHOR, SITE_ROLE } from '../consts';
import { cvPath, getLang } from '../i18n';

const year = new Date().getFullYear();
const SOCIALS = [
  { href: `mailto:${EMAIL}`, label: 'Email', externo: false },
  { href: LINKEDIN, label: 'LinkedIn', externo: true },
  { href: cvPath(getLang(Astro.url)), label: 'CV (PDF)', externo: false },
];
---

<!--
  Footer en primary plano. En las páginas con ContactCTA queda pegado a él y
  forman un solo bloque; en el resto cierra la página él solo. Sin margen
  superior propio: la separación la pone la sección anterior.
-->
<footer class="bg-accent text-paper">
  <div
    class="flex w-full flex-col gap-3 border-t border-paper/20 px-6 py-8 text-sm text-paper/80 sm:flex-row sm:items-center sm:justify-between sm:px-10"
  >
    <p>© {year} {SITE_AUTHOR} · {SITE_ROLE}</p>
    <ul class="flex gap-4">
      {
        SOCIALS.map(({ href, label, externo }) => (
          <li>
            <a
              class="transition hover:text-paper"
              href={href}
              target={externo ? '_blank' : undefined}
              rel={externo ? 'me noopener' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
