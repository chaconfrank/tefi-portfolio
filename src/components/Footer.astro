---
import { SOCIALS, SITE_AUTHOR, SITE_ROLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-3 px-6 py-8 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE_AUTHOR} · {SITE_ROLE}</p>
    <ul class="flex gap-4">
      {
        SOCIALS.map(({ href, label, externo }) => (
          <li>
            <a
              class="transition hover:text-ink"
              href={href}
              target={externo ? '_blank' : undefined}
              rel={externo ? 'me noopener' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
