---
import AvailabilityBadge from './AvailabilityBadge.astro';
import { EMAIL, LINKEDIN, CV_PATH, BUSCANDO_TRABAJO } from '../consts';

interface Props {
  titulo?: string;
  texto?: string;
}

const {
  titulo = 'Lista para unirme a tu equipo de producto.',
  texto = 'Estoy abierta a nuevos retos profesionales y a oportunidades a jornada completa.',
} = Astro.props;
---

<!--
  Cierre en primary plano, a sangre completa y pegado al footer (que comparte
  el mismo fondo): juntos forman un solo bloque de cierre. El botón principal
  se invierte (papel sobre primary) porque aquí el fondo YA es el primary.
-->
<section class="mx-[calc(50%-50vw)] mt-20 -mb-16 bg-accent py-12 text-paper">
  <div class="flex w-full flex-col gap-8 px-6 sm:flex-row sm:items-center sm:justify-between sm:px-10">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">{titulo}</h2>
      <p class="mt-3 text-pretty text-paper/80">{texto}</p>

      <div class="mt-6 flex flex-wrap items-center gap-2.5">
        <a
          href={`mailto:${EMAIL}`}
          class="rounded-full bg-secondary px-5 py-2.5 text-sm font-medium text-secondary-ink transition hover:opacity-90"
        >
          Escríbeme
        </a>
        <a
          href={LINKEDIN}
          target="_blank"
          rel="noopener"
          class="rounded-full border border-paper/40 px-5 py-2.5 text-sm font-medium text-paper transition hover:bg-paper/10"
        >
          LinkedIn ↗
        </a>
        <a
          href={CV_PATH}
          class="px-2 text-sm text-paper/80 underline-offset-4 transition hover:text-paper hover:underline"
        >
          Descargar CV
        </a>
      </div>
    </div>

    {BUSCANDO_TRABAJO && <AvailabilityBadge />}
  </div>
</section>
