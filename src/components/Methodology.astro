---
import metodologia from '../data/metodologia.json';

// Iconos de línea grandes y tenues, protagonistas del centro de cada tarjeta.
const iconos: Record<string, string> = {
  lupa: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  estructura:
    '<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4m0 0H6v4m6-4h6v4"/>',
  test: '<path d="M9.5 3h5M10.5 3v5.2L5 17.5a2 2 0 0 0 1.8 2.9h10.4a2 2 0 0 0 1.8-2.9L13.5 8.2V3"/><path d="M7.5 14h9"/>',
  calidad:
    '<path d="M12 3l7 3v5.5c0 4.3-2.9 7.3-7 8.9-4.1-1.6-7-4.6-7-8.9V6l7-3Z"/><path d="m9 11.8 2.1 2.1 3.9-4.2"/>',
};
---

<!--
  Cómo trabaja, en cuatro pasos: número arriba y título en primary, el icono
  como pieza central en trazo tenue del primary, y flechas curvas en tertiary
  uniendo las tarjetas en escritorio. Tres disposiciones: apiladas en móvil, carrusel con
  scroll-snap y zoom en mediana, y las cuatro en fila en grande.

  El `reveal` va en el CONTENEDOR: dentro de un scroller horizontal,
  `animation-timeline: view()` mediría el eje del carrusel y las tarjetas se
  quedarían congeladas a mitad de animación.
-->
<section id="metodo" class="py-10">
  <h2 class="text-sm font-medium tracking-wide text-ink-soft uppercase"><span aria-hidden="true">—</span> Cómo trabajo</h2>

  <p class="mt-5 pl-4 text-2xl font-semibold sm:pl-6 tracking-tight text-balance sm:text-3xl">
    Diseño estratégico que hace que los productos funcionen.
  </p>
  <p class="mt-4 pl-4 text-pretty text-ink-soft sm:pl-6">
    Trabajo para reducir la fricción entre la visión de diseño y la realidad del
    desarrollo. Desde la investigación inicial hasta el QA final sigo un método
    estructurado, pero ágil, para que cada funcionalidad aporte valor real.
  </p>

  <ol
    class="reveal mt-10 flex flex-col gap-5 pl-4 sm:pl-6 md:snap-x md:snap-mandatory md:flex-row md:overflow-x-auto md:pb-2 lg:gap-8 lg:overflow-visible lg:pb-0"
  >
    {
      metodologia.map(({ paso, titulo, texto, icono }, i) => (
        <li class="carousel-zoom relative flex flex-col rounded-3xl border border-line bg-paper p-6 shadow-[0_24px_50px_-28px_rgb(0_0_0/0.35)] md:w-80 md:shrink-0 md:snap-center lg:w-auto lg:flex-1 lg:shrink">
          <p class="text-sm font-semibold text-ink-soft tabular-nums">{paso}</p>
          <h3 class="mt-1 text-lg font-semibold tracking-tight text-balance text-accent">{titulo}</h3>

          <!-- m-auto vertical: el espacio sobrante de la card se reparte a
               partes iguales encima y debajo del icono, en vez de acumularse
               entero entre el icono y el párrafo. -->
          <svg
            class="m-auto size-20 text-accent/20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={iconos[icono]}
          />

          <p class="mt-3.5 text-sm text-pretty text-ink-soft">{texto}</p>

          {i < metodologia.length - 1 && (
            <svg
              class="pointer-events-none absolute top-16 -right-10 z-10 hidden w-12 text-metric lg:block"
              viewBox="0 0 48 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 19 C 16 5, 30 5, 42 14" />
              <path d="m36 10 7 4-8 3" />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
</section>
