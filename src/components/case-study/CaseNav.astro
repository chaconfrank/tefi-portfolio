---
import { getLang, UI } from '../../i18n';
const ui = UI[getLang(Astro.url)];
---

<!--
  Ayudas de lectura de un case study largo:
  - Barra de progreso arriba: CSS puro con scroll-driven animations. Donde el
    navegador no las soporta no se pinta (no hay fallback con JS).
  - Botón flotante «Capítulos» con el índice y botón de volver arriba. El
    índice se construye en el navegador a partir de los
    section[data-capitulo] que pinta CaseSection, así ningún MDX tiene que
    repetir sus capítulos. Aparece al pasar la primera pantalla y marca el
    capítulo que se está leyendo. Sin JavaScript no aparece.
-->
<case-nav class="contents">
  <div data-progreso aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-0.5 origin-left bg-accent"></div>

  <div data-barra hidden class="fixed right-4 bottom-4 z-50 flex flex-col items-end gap-2 sm:right-6 sm:bottom-6">
    <nav
      data-menu
      hidden
      id="case-nav-capitulos"
      aria-label={ui.capitulos}
      class="glass-strong max-h-[60vh] w-[min(20rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl p-2"
    >
      <ol data-lista class="text-sm"></ol>
    </nav>

    <div class="flex gap-2">
      <button
        type="button"
        data-abrir
        aria-expanded="false"
        aria-controls="case-nav-capitulos"
        class="glass-strong inline-flex h-11 items-center gap-2 rounded-full px-4 text-sm font-medium text-ink transition hover:bg-accent-soft"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path></svg>
        {ui.capitulos}
      </button>
      <button
        type="button"
        data-arriba
        aria-label={ui.volverArriba}
        class="glass-strong inline-flex size-11 items-center justify-center rounded-full text-ink transition hover:bg-accent-soft"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg>
      </button>
    </div>
  </div>
</case-nav>

<style>
  [data-progreso] {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    [data-progreso] {
      display: block;
      animation: progreso linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progreso {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  class CaseNav extends HTMLElement {
    connectedCallback() {
      const barra = this.querySelector<HTMLElement>('[data-barra]');
      const menu = this.querySelector<HTMLElement>('[data-menu]');
      const lista = this.querySelector<HTMLElement>('[data-lista]');
      const abrir = this.querySelector<HTMLButtonElement>('[data-abrir]');
      const arriba = this.querySelector<HTMLButtonElement>('[data-arriba]');
      const secciones = [...document.querySelectorAll<HTMLElement>('section[data-capitulo][id]')];
      if (!barra || !menu || !lista || !abrir || !arriba || secciones.length < 2) return;

      // Índice: «01» en el acento y el nombre del capítulo.
      const enlaces = secciones.map((s) => {
        const [numero, ...resto] = (s.dataset.capitulo ?? '').split(' · ');
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${s.id}`;
        a.className = 'flex gap-3 rounded-xl px-3 py-2 text-ink-soft transition hover:bg-accent-soft hover:text-ink aria-[current=true]:font-medium aria-[current=true]:text-ink';
        const n = document.createElement('span');
        n.className = 'text-accent tabular-nums';
        n.textContent = numero;
        const t = document.createElement('span');
        t.textContent = resto.join(' · ');
        a.append(n, t);
        li.append(a);
        lista.append(li);
        return a;
      });

      const cerrar = () => {
        menu.hidden = true;
        abrir.setAttribute('aria-expanded', 'false');
      };

      abrir.addEventListener('click', () => {
        const abierto = menu.hidden;
        menu.hidden = !abierto;
        abrir.setAttribute('aria-expanded', String(abierto));
      });
      lista.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) cerrar();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.hidden) {
          cerrar();
          abrir.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (!menu.hidden && !barra.contains(e.target as Node)) cerrar();
      });

      arriba.addEventListener('click', () => window.scrollTo({ top: 0 }));

      // Aparece pasada la primera pantalla (el hero).
      const mostrar = () => {
        const visible = window.scrollY > window.innerHeight * 0.8;
        barra.hidden = !visible;
        if (!visible) cerrar();
      };
      window.addEventListener('scroll', mostrar, { passive: true });
      mostrar();

      // Capítulo en lectura: el que cruza la franja central de la pantalla.
      const observador = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((e) => {
            if (!e.isIntersecting) return;
            const i = secciones.indexOf(e.target as HTMLElement);
            enlaces.forEach((a, j) => a.setAttribute('aria-current', String(i === j)));
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      secciones.forEach((s) => observador.observe(s));
    }
  }

  if (!customElements.get('case-nav')) {
    customElements.define('case-nav', CaseNav);
  }
</script>
