---
interface Props {
  // Se mantiene por compatibilidad con los MDX: el texto va siempre a todo
  // el ancho del contenedor.
  columna?: 'izquierda' | 'derecha';
  // El primer párrafo sube de tamaño y pasa a tinta: para la frase que
  // cierra el razonamiento de un bloque, no para un párrafo cualquiera.
  conclusion?: boolean;
  // Subtítulo de cuarto nivel (h4), para pasos dentro de una CaseSubsection.
  titulo?: string;
  // Pegado al subtítulo que lo precede (una CaseSubsection sin texto propio):
  // margen corto, para que subtítulo y primer paso se lean juntos.
  pegado?: boolean;
  // Ritmo apretado: el texto que sigue a un visual queda a ~48 px de él.
  compacta?: boolean;
}

const { columna = 'derecha', conclusion = false, titulo, pegado = false, compacta = false } = Astro.props;
void columna;
---

<!--
  Texto que continúa una sección después de un visual, para alternar texto y
  capturas sin abrir una sección nueva. Mismo ancho (todo el contenedor) y
  mismo cuerpo que el texto de CaseSection.
-->
<div class:list={[pegado ? 'mt-10 sm:mt-12' : compacta ? 'mt-10 sm:mt-12' : 'mt-20 sm:mt-24 lg:mt-28']}>
  {
    titulo && (
      <h4
        class="mb-6 text-xl leading-snug font-semibold tracking-tight text-balance"
      >
        {titulo}
      </h4>
    )
  }
  <div
    class:list={[
      'space-y-6 text-lg leading-relaxed text-pretty text-ink-soft',
      conclusion &&
        '[&>p:first-child]:text-xl [&>p:first-child]:leading-snug [&>p:first-child]:font-medium [&>p:first-child]:text-ink sm:[&>p:first-child]:text-2xl',
    ]}
  >
    <slot />
  </div>
</div>
