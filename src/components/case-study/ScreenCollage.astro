---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Captura {
  imagen: ImageMetadata;
  alt: string;
}

interface Props {
  // Tres capturas: la principal, la que se apoya a su derecha y la panorámica
  // que cierra abajo. El orden decide el sitio, no el tamaño del archivo.
  capturas: [Captura, Captura, Captura];
  etiqueta: string;
  // Ritmo apretado, a juego con CaseSection compacta.
  compacta?: boolean;
}

const { capturas, etiqueta, compacta = false } = Astro.props;

// Composición en escritorio, todo en % del ancho del bloque (también el
// desplazamiento vertical: un margin-top en % se mide contra el ancho). La
// altura de cada captura sale de su proporción real, así que nunca se recorta
// ni se deforma.
const [a] = capturas.map(({ imagen }) => imagen.height / imagen.width);
const huecoVertical = 3.5;
const posiciones = [
  { left: 0, top: 0, width: 58 },
  // Se mete 1,75 % bajo la principal: las dos capturas tienen ahí margen
  // vacío, así el solape se nota sin tapar interfaz.
  { left: 56.25, top: 10.4, width: 43.75 },
  { left: 8.33, top: 58 * a + huecoVertical, width: 53.8 },
];
---

<!--
  Capturas de una versión anterior tratadas como documentación de producto:
  marco limpio, sin mockup de dispositivo. En móvil se apilan a todo el ancho
  (en pequeño no se leerían); desde lg se componen con ligeros solapes y
  tamaños distintos: las tres capturas y el pie comparten la única celda de
  una rejilla (grid-area 1/1) y cada una se coloca con márgenes en %, pasados
  por variables. La celda crece con la captura que llega más abajo, sin
  posiciones absolutas ni alto calculado. La tercera va por encima de la
  segunda para que no se le tape el logo de la esquina.
  Las capturas originales miden ~850 px: no se pide ningún ancho mayor.
-->
<figure
  class:list={[
    'flex flex-col gap-6 sm:gap-8 lg:grid lg:items-start',
    compacta ? 'mt-10 sm:mt-12' : 'mt-20 sm:mt-24 lg:mt-28',
  ]}
>
  {
    capturas.map(({ imagen, alt }, i) => (
      <div
        class:list={[
          'overflow-hidden rounded-xl bg-paper shadow-xl ring-1 shadow-ink/10 ring-ink/10 lg:[grid-area:1/1] lg:mt-(--y) lg:ml-(--x) lg:w-(--w)',
          ['lg:z-10', 'lg:z-0', 'lg:z-20'][i],
        ]}
        style={`--x: ${posiciones[i].left}%; --y: ${posiciones[i].top}%; --w: ${posiciones[i].width}%`}
      >
        <Image src={imagen} alt={alt} quality="high" sizes="(min-width: 64rem) 668px, 100vw" class="h-auto w-full" />
      </div>
    ))
  }

  <figcaption class="text-xs font-medium tracking-[0.14em] text-ink-soft uppercase lg:[grid-area:1/1] lg:self-end lg:justify-self-end">
    {etiqueta}
  </figcaption>
</figure>

