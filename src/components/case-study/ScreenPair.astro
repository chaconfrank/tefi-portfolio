---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Captura {
  imagen: ImageMetadata;
  alt: string;
  // Nombre corto de la pantalla, va debajo de la captura.
  etiqueta: string;
}

interface Props {
  capturas: [Captura, Captura];
  // Ritmo apretado, a juego con CaseSection compacta.
  compacta?: boolean;
}

const { capturas, compacta = false } = Astro.props;
---

<!--
  Dos pantallas relacionadas, lado a lado y a la misma altura, ocupando
  juntas el contenedor visual: en escritorio el bloque se sale de max-w-6xl
  hasta 80rem (sin pasar del viewport menos el margen de página), igual que
  ScreenEvolution, para que cada captura se vea a ~610 px y no quede pequeña
  en medio de blanco. La etiqueta va debajo de cada una.
  Por debajo de lg se apilan a todo el ancho.
-->
<div
  class:list={[
    'grid gap-y-10 lg:relative lg:left-1/2 lg:w-[min(80rem,calc(100vw-5rem))] lg:-translate-x-1/2 lg:grid-cols-2 lg:gap-x-8',
    compacta ? 'mt-10 sm:mt-12' : 'mt-20 sm:mt-24 lg:mt-28',
  ]}
>
  {
    capturas.map(({ imagen, alt, etiqueta }) => (
      <figure>
        <div class="overflow-hidden rounded-xl bg-paper shadow-xl ring-1 shadow-ink/10 ring-ink/10">
          <Image
            src={imagen}
            alt={alt}
            widths={[640, 1280, Math.min(imagen.width, 1708)]}
            sizes="(min-width: 64rem) 624px, 100vw"
            quality="high"
            class="h-auto w-full"
          />
        </div>
        <figcaption class="mt-4 text-xs font-medium tracking-[0.14em] text-ink-soft uppercase">{etiqueta}</figcaption>
      </figure>
    ))
  }
</div>
