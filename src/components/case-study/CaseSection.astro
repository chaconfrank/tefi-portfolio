---
interface Props {
  id: string;
  // "01", "02"... va en el acento de Amaia, delante de la etiqueta.
  numero: string;
  etiqueta: string;
  titulo: string;
  // 'dividida': titular a la izquierda y texto en columna a la derecha.
  // 'apilada': titular arriba, texto a la izquierda y el destacado al lado.
  // Alternarlas es lo que evita que todas las secciones se lean iguales.
  composicion?: 'dividida' | 'apilada';
  // Idea corta que resume la sección. No es una cita: no lleva comillas ni
  // tamaño de pull quote, sólo se separa del texto con el filete de Amaia.
  destacado?: string;
  // Ritmo más apretado (capítulos a ~112 px, título y texto más juntos) para
  // casos largos en los que el aire por defecto alarga demasiado la página.
  compacta?: boolean;
}

const { id, numero, etiqueta, titulo, composicion = 'dividida', destacado, compacta = false } = Astro.props;
const apilada = composicion === 'apilada';
---

<!--
  Sección numerada del case study. El texto nunca pasa de max-w-2xl (~65
  caracteres) aunque la sección use el ancho generoso de max-w-6xl.
  Lo visual de la sección (capturas, diagramas) llega por el slot "media" y
  se pinta debajo con su propio aire.

  Los <p> del texto los genera el MDX y no llevan el scope del componente:
  por eso van con variantes [&>p] en vez de un <style>.
-->
<section
  id={id}
  aria-labelledby={`${id}-titulo`}
  class:list={['mx-auto max-w-6xl scroll-mt-28', compacta ? 'mt-20 sm:mt-24 lg:mt-28' : 'mt-28 sm:mt-36 lg:mt-44']}
>
  <div class="lg:grid lg:grid-cols-12 lg:gap-x-10">
    <header class:list={[apilada ? 'lg:col-span-9' : 'lg:col-span-5']}>
      <p class="text-xs font-medium tracking-[0.14em] uppercase">
        <span class="text-amaia-ink">{numero}</span>{' '}
        <span class="text-ink-soft"><span aria-hidden="true">·</span> {etiqueta}</span>
      </p>
      <h2 id={`${id}-titulo`} class="mt-5 text-3xl leading-[1.12] font-semibold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem]">
        {titulo}
      </h2>
    </header>

    <div
      class:list={[
        'max-w-2xl space-y-6 text-lg leading-relaxed text-pretty text-ink-soft [&>p:first-child]:text-ink',
        compacta ? 'mt-6 sm:mt-8' : 'mt-10',
        apilada ? ['lg:col-span-7', compacta ? 'lg:mt-8' : 'lg:mt-14'] : 'lg:col-span-6 lg:col-start-7 lg:mt-14',
      ]}
    >
      <slot />
    </div>

    {
      destacado && (
        <p
          class:list={[
            compacta ? 'mt-10' : 'mt-12',
            'max-w-sm border-l-2 border-amaia-ink pl-5 text-xl leading-snug font-medium text-balance text-ink',
            apilada ? 'lg:col-span-4 lg:col-start-9 lg:mt-0 lg:self-end' : 'lg:col-span-6 lg:col-start-7',
          ]}
        >
          {destacado}
        </p>
      )
    }
  </div>

  <slot name="media" />
</section>
