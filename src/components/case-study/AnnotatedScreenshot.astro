---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Nota {
  texto: string;
  // Posición del marcador en % de la captura (0–100), medida sobre el
  // archivo original: no cambia aunque la captura se escale.
  x: number;
  y: number;
}

interface Props {
  imagen: ImageMetadata;
  alt: string;
  notas: Nota[];
  // Ancho en escritorio, en px CSS (7 de 12 columnas ≈ 655).
  ancho?: number;
}

const { imagen, alt, notas, ancho = 655 } = Astro.props;
const widths = [...new Set([ancho, ancho * 2].map((w) => Math.min(w, imagen.width)))];
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<!--
  Captura con anotaciones discretas: marcadores numerados encima de la
  interfaz y la leyenda al lado (debajo en móvil). Los marcadores son
  aria-hidden: la leyenda es el texto real y el alt describe la pantalla.
  Los marcadores van en el acento de Amaia con aro del color del papel, para
  que se separen de la interfaz sin tapar nada que haya que leer.
-->
<figure class="mt-20 sm:mt-24 lg:mt-28 lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-10">
  <div class="relative lg:col-span-7">
    <div class="overflow-hidden rounded-xl bg-paper shadow-xl ring-1 shadow-ink/10 ring-ink/10">
      <Image src={imagen} alt={alt} widths={widths} sizes={`(min-width: 64rem) ${ancho}px, 100vw`} quality="high" class="h-auto w-full" />
    </div>
    {
      notas.map(({ x, y }, i) => (
        <span
          aria-hidden="true"
          class="absolute flex size-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-amaia-ink text-xs font-semibold text-paper tabular-nums shadow-md ring-2 ring-paper"
          style={`left: ${x}%; top: ${y}%`}
        >
          {i + 1}
        </span>
      ))
    }
  </div>

  <figcaption class="mt-10 lg:col-span-4 lg:col-start-9 lg:mt-0">
    <ol class="space-y-5">
      {
        notas.map(({ texto }, i) => (
          <li class="border-t border-line pt-4 text-lg leading-snug">
            <span class="font-medium text-amaia-ink tabular-nums">{numero(i)}</span>{' '}
            <span aria-hidden="true" class="text-ink-soft">
              ·
            </span>{' '}
            <span class="text-ink">{texto}</span>
          </li>
        ))
      }
    </ol>
  </figcaption>
</figure>
