---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  // Producto del caso; va en el acento de su marca, delante de la disciplina.
  producto: string;
  // Sin disciplina, el eyebrow es sólo el producto.
  disciplina?: string;
  titulo: string;
  imagen: ImageMetadata;
  imagenAlt: string;
  // Una línea que sitúa el producto antes de la entradilla, en tono menor.
  contexto?: string;
  // La banda gris a sangre bajo la composición. Sólo tiene sentido si justo
  // debajo va la franja de datos (CaseFacts), que la continúa; sin franja
  // la banda se cortaría en seco al pie de la imagen.
  banda?: boolean;
  // Pasos del recorrido en una línea bajo la entradilla ("Entrevistar →
  // Agrupar → …"): resume el caso de un vistazo sin otro visual.
  recorrido?: string[];
  // Menos aire entre las piezas del hero, a juego con CaseSection compacta.
  compacta?: boolean;
  // Texto a la izquierda y composición a la derecha desde lg, en una sola
  // fila: el hero se lee como una apertura y no como texto + imagen apilados.
  // Sin banda: la franja de datos va debajo con su propio filete.
  lateral?: boolean;
  // Sólo con lateral: la entradilla y el recorrido salen de la columna de
  // texto y ocupan todo el ancho, debajo de la fila título + composición.
  // Para entradillas largas que alargarían demasiado la columna izquierda.
  entradillaAncha?: boolean;
}

const {
  producto,
  disciplina,
  titulo,
  imagen,
  imagenAlt,
  contexto,
  banda = true,
  recorrido,
  compacta = false,
  lateral = false,
  entradillaAncha = false,
} = Astro.props;
const ancha = lateral && entradillaAncha;
const widths = [...new Set([768, 1152, 1800].map((w) => Math.min(w, imagen.width)))];
// En lateral hay dos envoltorios: el bloque (con el relleno superior y el
// enlace de vuelta) y, dentro, la rejilla de dos columnas. Sin lateral no
// existen y el header lleva su propio relleno.
// La composición se alinea arriba, con el eyebrow, y no centrada respecto al
// texto: si el texto es largo (Wedify), centrarla la bajaba hasta quedar
// medio fuera de la primera pantalla. Por eso el enlace va fuera de la
// rejilla: si no, la imagen arrancaría por encima del eyebrow.
const Bloque = lateral ? 'div' : Fragment;
const bloqueProps = lateral ? { class: 'mx-auto max-w-6xl pt-10 sm:pt-16 lg:pt-24' } : {};
const Rejilla = lateral ? 'div' : Fragment;
// Con entradilla ancha el header pasa a `contents` en lg y sus piezas son
// celdas de la rejilla: eyebrow, título y contexto a la izquierda (filas
// 1–3), la composición a la derecha ocupando también la fila 4, que es
// elástica (1fr) para que, si la imagen es más alta que el título, el hueco
// quede debajo y no repartido entre eyebrow, título y contexto; y la
// entradilla y el recorrido a todo el ancho en las filas 5 y 6.
const rejillaProps = lateral
  ? {
      class: [
        compacta ? 'mt-10 sm:mt-12' : 'mt-12 sm:mt-16',
        'lg:grid lg:grid-cols-[5fr_7fr] lg:items-start lg:gap-x-12',
        ancha && 'lg:grid-rows-[auto_auto_auto_1fr_auto_auto]',
      ]
        .filter(Boolean)
        .join(' '),
    }
  : {};
import { getLang, ruta, UI } from '../../i18n';
const lang = getLang(Astro.url);
const ui = UI[lang];
---

<!--
  Apertura del case study: texto, composición de producto y (justo debajo, en
  el MDX) la franja de datos se leen como un único bloque.

  - La entradilla llega por el slot: el primer párrafo hace de lead (más
    grande, en tinta) y el resto baja a texto secundario. Va con variantes
    [&>p] porque los <p> los genera el MDX y no llevan el scope del componente.
  - La composición se pinta tal cual: sin recorte (sin object-cover ni
    aspect-*) y sin pedir más ancho del que tiene el archivo.
  - El ::after de la figura es la banda gris a sangre que arranca a media
    altura de los dispositivos y continúa en la franja de datos: es lo que
    "posa" la composición y la une a la franja. `isolate` mantiene la banda
    detrás de la imagen sin que se vaya debajo del fondo de la página.
-->
<Bloque {...bloqueProps}>
{lateral && <a href={ruta(lang, 'proyectos')} class="text-sm text-ink-soft transition hover:text-ink">{ui.volverProyectos}</a>}
<Rejilla {...rejillaProps}>
<header class:list={[!lateral && 'mx-auto max-w-6xl pt-10 sm:pt-16 lg:pt-24', ancha && 'lg:contents']}>
  {!lateral && <a href={ruta(lang, 'proyectos')} class="text-sm text-ink-soft transition hover:text-ink">{ui.volverProyectos}</a>}

  <p
    class:list={[
      'text-xs font-medium tracking-[0.14em] uppercase',
      !lateral && (compacta ? 'mt-10 sm:mt-12' : 'mt-12 sm:mt-16'),
      ancha && 'lg:col-start-1',
    ]}
  >
    <span class="text-amaia-ink">{producto}</span>
    {
      disciplina && (
        <>
          {' '}
          <span class="text-ink-soft">
            <span aria-hidden="true">·</span> {disciplina}
          </span>
        </>
      )
    }
  </p>

  <h1
    class:list={[
      'mt-5 max-w-4xl text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl',
      lateral ? 'lg:text-4xl xl:text-5xl' : 'lg:text-6xl',
      ancha && 'lg:col-start-1',
    ]}
  >
    {titulo}
  </h1>

  {
    contexto && (
      <p
        class:list={[
          'max-w-xl text-base leading-relaxed text-pretty text-ink-soft',
          compacta ? 'mt-6 sm:mt-8' : 'mt-8 sm:mt-10',
          ancha && 'lg:col-start-1',
        ]}
      >
        {contexto}
      </p>
    )
  }

  <div
    class:list={[
      'max-w-2xl space-y-5 text-lg leading-relaxed text-pretty text-ink-soft [&>p:first-child]:text-xl [&>p:first-child]:text-ink sm:[&>p:first-child]:text-2xl sm:[&>p:first-child]:leading-snug',
      compacta ? 'mt-6 sm:mt-8' : 'mt-10 sm:mt-12',
      lateral && 'lg:[&>p:first-child]:text-xl',
      ancha && 'lg:col-span-2 lg:row-start-5 lg:mt-10 lg:max-w-none',
    ]}
  >
    <slot />
  </div>

  {
    recorrido && (
      <ol
        aria-label={ui.recorrido}
        class:list={[
          'flex flex-wrap items-center gap-x-3 gap-y-2 text-base font-medium sm:text-lg',
          compacta ? 'mt-8' : 'mt-10 sm:mt-12',
          ancha && 'lg:col-span-2 lg:row-start-6',
        ]}
      >
        {recorrido.map((paso, i) => (
          <li class="flex items-center gap-x-3">
            {i > 0 && (
              <span aria-hidden="true" class="text-amaia-ink">
                →
              </span>
            )}
            {paso}
          </li>
        ))}
      </ol>
    )
  }

  {/* Sólo en inglés: las capturas son del producto real, que está en español. */}
  {
    ui.notaIdioma && (
      <p class:list={['mt-6 text-sm text-ink-soft', ancha && 'lg:col-span-2 lg:row-start-7']}>{ui.notaIdioma}</p>
    )
  }
</header>

<figure
  class:list={[
    'relative isolate',
    lateral ? 'mt-10 sm:mt-12 lg:mt-0' : compacta ? 'mt-12 sm:mt-16' : 'mt-20 sm:mt-28 lg:mt-32',
    ancha && 'lg:col-start-2 lg:row-span-4 lg:row-start-1',
    banda && 'after:absolute after:inset-x-[calc(50%-50vw)] after:top-[68%] after:bottom-0 after:-z-10 after:bg-paper-soft',
  ]}
>
  <Image
    src={imagen}
    alt={imagenAlt}
    widths={widths}
    sizes={lateral ? '(min-width: 64rem) 680px, 100vw' : '(max-width: 72rem) 100vw, 72rem'}
    loading="eager"
    fetchpriority="high"
    class="mx-auto h-auto w-full max-w-6xl"
  />
</figure>
</Rejilla>
</Bloque>
