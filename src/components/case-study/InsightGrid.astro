---
interface Insight {
  titulo: string;
  // El insight y sus ejemplos (Centro A–F), uno por párrafo.
  parrafos: string[];
}

interface Props {
  insights: Insight[];
  // Ritmo apretado, a juego con CaseSection compacta.
  compacta?: boolean;
  // Nivel de los títulos: 4 bajo una CaseSubsection (h3); 3 si el grid va
  // directamente en una CaseSection (h2), para no saltarse un nivel.
  nivel?: 3 | 4;
}

const { insights, compacta = false, nivel = 4 } = Astro.props;
const Titulo = `h${nivel}` as 'h3' | 'h4';
---

<!--
  Insights de research compactos, en 2×2 desde md: número y título en peso,
  la idea en tinta y los ejemplos por centro en gris debajo. Más ligero que
  FindingsMatrix: aquí cada insight se lee de un vistazo, no es una tabla
  de síntesis.
-->
<ol class:list={['grid gap-x-10 md:grid-cols-2', compacta ? 'mt-10 gap-y-8 sm:mt-12 md:gap-y-10' : 'mt-14 gap-y-12 sm:mt-16 md:gap-y-14']}>
  {
    insights.map(({ titulo, parrafos }, i) => (
      <li class="border-t border-line pt-6">
        <Titulo class="text-xl leading-snug font-semibold tracking-tight text-balance">
          <span class="text-amaia-ink tabular-nums">{String(i + 1).padStart(2, '0')}</span>{' '}
          <span aria-hidden="true" class="text-ink-soft">
            ·
          </span>{' '}
          {titulo}
        </Titulo>
        <div class="mt-4 space-y-3 leading-relaxed text-pretty text-ink-soft [&>p:first-child]:text-lg [&>p:first-child]:text-ink">
          {parrafos.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </li>
    ))
  }
</ol>
