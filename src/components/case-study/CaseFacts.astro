---
interface Dato {
  etiqueta: string;
  valor: string;
  // Líneas de apoyo bajo el valor: fechas, desglose de productos...
  detalle?: string[];
}

interface Props {
  datos: Dato[];
  // Ritmo apretado, a juego con CaseSection compacta.
  compacta?: boolean;
  // Sin fondo: franja ligera entre dos filetes, en el ancho de la página y
  // con margen propio. Para un hero lateral, donde no hay banda que continuar.
  fondo?: boolean;
}

const { datos, compacta = false, fondo = true } = Astro.props;
import { getLang, UI } from '../../i18n';
const ui = UI[getLang(Astro.url)];
---

<!--
  Franja de datos a sangre bajo la composición del hero. Comparte el gris
  (bg-paper-soft) con la banda que arranca detrás de los dispositivos, así
  que sin hueco entre ambas se leen como una sola pieza.
  Sin tarjetas: columnas separadas por un filete vertical en escritorio y
  horizontal en móvil.
-->
<section
  aria-label={ui.datosProyecto}
  class:list={[
    fondo
      ? ['mx-[calc(50%-50vw)] bg-paper-soft px-6 pt-6 sm:px-10 sm:pt-10', compacta ? 'pb-10 sm:pb-12' : 'pb-14 sm:pb-20']
      : 'mx-auto mt-12 max-w-6xl sm:mt-14 lg:mt-16',
  ]}
>
  <dl
    class:list={[
      'mx-auto grid max-w-6xl sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-[1fr_1fr_1.15fr_1.35fr] lg:gap-x-0',
      fondo ? 'gap-y-8' : 'gap-y-6 border-y border-line py-6 min-[25rem]:grid-cols-2 min-[25rem]:gap-x-6 sm:py-7',
    ]}
  >
    {
      datos.map(({ etiqueta, valor, detalle }) => (
        <div
          class:list={[
            fondo && 'border-t border-line pt-5 lg:border-t-0 lg:pt-0',
            // Sin fondo y por debajo de 400 px (una sola columna): etiqueta a
            // la izquierda y valor a la derecha, para que los cuatro datos no
            // ocupen media pantalla.
            !fondo && 'max-[25rem]:grid max-[25rem]:grid-cols-[6rem_1fr] max-[25rem]:items-baseline max-[25rem]:gap-x-4',
            'lg:border-l lg:px-8 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0',
          ]}
        >
          <dt class="text-xs font-medium tracking-[0.14em] text-ink-soft uppercase">{etiqueta}</dt>
          <dd class:list={['mt-3', !fondo && 'max-[25rem]:mt-0']}>
            <span class="block text-lg leading-snug font-medium text-balance text-ink">{valor}</span>
            {detalle && (
              <ul class="mt-2 space-y-1 text-sm text-ink-soft">
                {detalle.map((linea) => (
                  <li>{linea}</li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
