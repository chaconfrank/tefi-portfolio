---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  imagen: ImageMetadata;
  // Describe el flujo entero, paso a paso: el lector de pantalla no ve el
  // gráfico y el texto del diagrama vive dentro de la imagen.
  alt: string;
  // En móvil, mantener 44rem y desplazar en horizontal. Para diagramas con
  // texto pequeño; una composición de dispositivos se ve mejor reducida.
  desplazable?: boolean;
  // Ancho máximo en px CSS para gráficos de apoyo que no deben ocupar toda
  // la sección; se centran. Sin él, van a todo el ancho (72rem).
  ancho?: number;
  pie?: string;
  // Versión vertical del mismo gráfico para móvil (por debajo de md). Un
  // diagrama horizontal escalado a ~340 px deja el texto en 4–5 px; con esta
  // versión el navegador elige la imagen según el ancho, sin JavaScript.
  imagenMovil?: ImageMetadata;
  // Margen texto → gráfico de 48 px, como el resto de visuales compactos.
  // El de 64 compensaba el aire transparente que traían los PNG; con ese
  // aire recortado, sobra.
  compacta?: boolean;
  // Con imagenMovil: la versión vertical a todo el ancho del móvil en vez de
  // a la escala del escritorio. Para composiciones de pantallas, que a 0,45
  // no se leerían; los diagramas de pasos van sin ella.
  movilCompleto?: boolean;
  // En escritorio se sale de max-w-6xl hasta 80rem, como las parejas de
  // capturas: para la composición protagonista de una sección.
  amplio?: boolean;
}

const { imagen, alt, ancho, pie, imagenMovil, compacta = false, movilCompleto = false, amplio = false } = Astro.props;
// Con versión vertical no hace falta desplazar en horizontal: ya se lee.
const desplazable = imagenMovil ? false : (Astro.props.desplazable ?? true);
const maximo = ancho ?? (amplio ? 1280 : 1152);
const widths = [...new Set([768, maximo, maximo * 2].map((w) => Math.min(w, imagen.width)))];
const movil = imagenMovil
  ? await getImage({
      src: imagenMovil,
      widths: [...new Set([480, 720, imagenMovil.width].map((w) => Math.min(w, imagenMovil.width)))],
      quality: 'high',
    })
  : undefined;
const Marco = movil ? 'picture' : Fragment;
// La versión vertical se pinta en móvil a la misma escala que el gráfico
// horizontal en escritorio (~0,45 del archivo): el texto se lee igual y no
// ocupa más de lo necesario. A todo el ancho, un flujo de cinco pasos
// pasaba de dos pantallas de alto.
const anchoMovil = imagenMovil && !movilCompleto ? Math.round(imagenMovil.width * 0.45) : undefined;
// Los anchos van como variables y se aplican con clases: un max-width en
// línea ganaría a la clase de móvil.
const estilo = [ancho && `--ancho-max: ${ancho}px`, anchoMovil && `--ancho-movil: ${anchoMovil}px`].filter(Boolean).join('; ') || undefined;
---

<!--
  Gráfico entregado ya diseñado (diagramas de flujo, infografías, montajes): se pinta tal cual, a
  todo el ancho de la sección y sin el marco de captura, porque no es una
  pantalla del producto.
  Sin lámina de fondo: los gráficos van con fondo transparente y las cajas
  con relleno claro propio, así que se leen igual en claro y en oscuro. Si
  llega uno con fondo blanco opaco, se le quita el blanco exterior antes de
  meterlo (relleno desde las esquinas con poca tolerancia, para no comerse
  los paneles claros del diseño).
  En móvil el gráfico a todo el ancho queda ilegible: por debajo de md
  mantiene 44rem de ancho y se desplaza en horizontal dentro de su lámina.
  Margen superior menor que el de una captura: estos PNG traen su propio
  aire transparente arriba y abajo, y sumado al margen el hueco se duplicaba.
-->
<figure
  class:list={[
    'mx-auto',
    compacta ? 'mt-10 sm:mt-12' : 'mt-12 sm:mt-14 lg:mt-16',
    ancho && 'max-w-(--ancho-max)',
    amplio && 'lg:relative lg:left-1/2 lg:w-[min(80rem,calc(100vw-5rem))] lg:max-w-none lg:-translate-x-1/2',
    anchoMovil && 'max-md:max-w-(--ancho-movil)',
    // Pantallas a todo el ancho sólo hasta 32rem: en tablet vertical una
    // composición apilada de tres pantallas pasaba de 2.700 px de alto.
    imagenMovil && movilCompleto && 'max-md:max-w-[32rem]',
  ]}
  style={estilo}
>
  <div class:list={['rounded-2xl', desplazable ? 'overflow-x-auto md:overflow-hidden' : 'overflow-hidden']}>
    <Marco>
    {
      movil && imagenMovil && (
        <source
          media="(max-width: 47.99rem)"
          srcset={movil.srcSet.attribute}
          sizes={anchoMovil ? `${anchoMovil}px` : '(max-width: 32rem) 100vw, 32rem'}
          type="image/webp"
          width={imagenMovil.width}
          height={imagenMovil.height}
        />
      )
    }
    <Image
      src={imagen}
      alt={alt}
      widths={widths}
      sizes={desplazable ? `(max-width: 48rem) 44rem, (max-width: 72rem) 100vw, ${maximo}px` : `(max-width: ${maximo}px) 100vw, ${maximo}px`}
      quality="high"
      class:list={['h-auto w-full', desplazable && 'min-w-[44rem] md:min-w-0']}
    />
    </Marco>
  </div>
  {pie && <figcaption class="mt-4 text-sm leading-relaxed text-pretty text-ink-soft">{pie}</figcaption>}
</figure>
