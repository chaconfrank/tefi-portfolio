---
import type { ImageMetadata } from 'astro';
import Screenshot from './Screenshot.astro';

interface Props {
  // "V1", "V2"... va en el acento de Amaia delante del nombre de la versión.
  version: string;
  titulo: string;
  imagen: ImageMetadata;
  alt: string;
  // 'columna': una de las versiones previas, en una fila de dos dentro de un
  // grid de dos columnas (lg:grid-cols-2) que pone el MDX. 'completa': la
  // versión final, más grande, con el texto arriba y la captura a todo el
  // ancho.
  disposicion: 'columna' | 'completa';
}

const { version, titulo, imagen, alt, disposicion } = Astro.props;
const columna = disposicion === 'columna';
---

<!--
  Una versión de una pantalla dentro de una secuencia de iteraciones.

  - 'columna': título, texto y captura seguidos, sin alinear con la otra
    columna. Alinear las capturas de V1 y V2 dejaba la de V1 a ~260 px de su
    texto (el de V2 es tres veces más largo) y se perdía qué explica qué.
    Captura ≈ 552 px a 72rem.
  - 'completa' deja título y texto en la columna de lectura, uno debajo del
    otro, y la captura a todo el ancho (1152 px): es la dirección final y
    tiene que pesar más que las previas.
-->
<div class:list={[!columna && 'mt-16 sm:mt-18 lg:mt-20']}>
  <h3 class="max-w-4xl text-2xl leading-tight font-semibold tracking-tight text-balance">
    <span class="text-amaia-ink">{version}</span> <span aria-hidden="true" class="text-ink-soft">·</span>{' '}
    {titulo}
  </h3>
  <div class="mt-5 space-y-5 text-lg leading-relaxed text-pretty text-ink-soft">
    <slot />
  </div>
  <Screenshot imagen={imagen} alt={alt} ancho={columna ? 552 : 1152} class:list={['mt-8', !columna && 'lg:mt-10']} />
</div>
