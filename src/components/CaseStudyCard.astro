---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { titulo, titular, descripcion, rol, empresa, rolResumen, portada, portadaAlt, metricas } =
  proyecto.data;

const href = `/proyectos/${proyecto.id}/`;
// El chip de la esquina dice la empresa; si el campo falta se deriva del
// título («Wedify — SaaS…» → «Wedify»).
const chip = empresa ?? titulo.split('—')[0].trim();
---

<!--
  Tarjeta simplificada: imagen a sangre arriba (~60/40 con el texto), chip de
  empresa sobre ella, y el texto en tres líneas — rol en mayúsculas pequeñas,
  titular como título enlazado y descripción — más las métricas. Sin tipo,
  fechas, chips de herramientas ni enlace de texto: la acción la señala la
  etiqueta «Ver proyecto» que sigue al cursor (sólo en dispositivos con hover;
  sin JS o en táctil la tarjeta entera sigue siendo un enlace normal).
-->
<case-study-card>
  <article
    class="reveal group relative overflow-hidden rounded-2xl border border-line bg-paper shadow-sm transition hover:border-accent/50"
  >
    <div class="relative">
      {
        portada ? (
          <Image
            src={portada}
            alt={portadaAlt ?? ''}
            widths={[640, 1280]}
            sizes="(max-width: 768px) 100vw, 1200px"
            class="aspect-[16/9] max-h-96 w-full object-cover"
          />
        ) : (
          /* Hueco de la portada pendiente de subir. */
          <div
            class="flex aspect-[16/9] max-h-96 w-full items-center justify-center bg-paper-soft text-ink-soft/30"
            aria-hidden="true"
          >
            <svg
              class="size-12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <circle cx="9" cy="10" r="1.8" />
              <path d="m5 19 5.5-5.5 3 3L17 13l4 4" />
            </svg>
          </div>
        )
      }
      <span class="glass-strong absolute top-4 left-4 rounded-full px-3 py-1 text-xs font-medium text-ink">
        {chip}
      </span>
    </div>

    <div class="p-5 sm:p-6">
      <p class="text-xs font-medium tracking-wide text-ink-soft uppercase">{rolResumen ?? rol}</p>

      <h3 class="mt-1.5 text-xl font-semibold tracking-tight text-balance">
        <!-- Enlace que cubre la tarjeta: el resto del contenido queda encima con z-10 -->
        <a href={href} class="after:absolute after:inset-0 group-hover:text-accent">{titular ?? titulo}</a>
      </h3>

      <p class="mt-2 text-pretty text-ink-soft">{descripcion}</p>

      {
        metricas.length > 0 && (
          <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-4 sm:grid-cols-3">
            {metricas.map(({ valor, etiqueta }) => (
              <div>
                <dt class="sr-only">{etiqueta}</dt>
                <dd class="text-lg font-semibold tracking-tight text-metric">{valor}</dd>
                <p class="text-xs text-ink-soft">{etiqueta}</p>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <!--
      Etiqueta que sigue al cursor con aspecto de botón primario. Nace con
      `hidden` y el script sólo la activa cuando hay puntero con hover, así
      nunca estorba en táctil ni sin JavaScript. `aria-hidden`: es decorativa,
      el enlace real es el del título.
    -->
    <span
      data-cursor
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-0 z-20 hidden w-max rounded-full bg-accent px-4 py-2 text-sm font-medium text-paper opacity-0 shadow-sm transition-opacity duration-150 group-hover:opacity-100"
    >
      Ver proyecto
    </span>
  </article>
</case-study-card>

<script>
  class CaseStudyCard extends HTMLElement {
    connectedCallback() {
      const article = this.querySelector('article');
      const pill = this.querySelector<HTMLElement>('[data-cursor]');
      if (!article || !pill) return;
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

      pill.classList.remove('hidden');
      article.addEventListener('pointermove', (event) => {
        const rect = article.getBoundingClientRect();
        pill.style.transform = `translate(${event.clientX - rect.left + 18}px, ${event.clientY - rect.top + 18}px)`;
      });
    }
  }

  if (!customElements.get('case-study-card')) {
    customElements.define('case-study-card', CaseStudyCard);
  }
</script>
