---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  // 'destacado' pinta la portada; 'compacto' la omite (listados largos).
  variante?: 'destacado' | 'compacto';
}

const { proyecto, variante = 'destacado' } = Astro.props;
const { titulo, titular, descripcion, tipo, rol, periodo, portada, portadaAlt, metricas, herramientas } =
  proyecto.data;

const href = `/proyectos/${proyecto.id}/`;
---

<article
  class="reveal group relative rounded-2xl border border-line bg-paper p-5 shadow-sm transition hover:border-accent/50 sm:p-6"
>
  <div class="flex items-center gap-3 text-xs text-ink-soft">
    <span class="rounded-md border border-line bg-paper px-2 py-0.5 font-medium text-ink">{tipo}</span>
    <span>{periodo}</span>
  </div>

  {
    titular && (
      <p class="mt-4 text-xs font-medium tracking-wide text-ink-soft uppercase">{titular}</p>
    )
  }

  <h3 class:list={[titular ? 'mt-1.5' : 'mt-3', 'text-xl font-semibold tracking-tight text-balance']}>
    <!-- Enlace que cubre la tarjeta: el resto del contenido queda encima con z-10 -->
    <a href={href} class="after:absolute after:inset-0 group-hover:text-accent">{titulo}</a>
  </h3>

  <p class="mt-2 text-pretty text-ink-soft">{descripcion}</p>

  <p class="mt-3 text-sm">
    <span class="text-ink-soft">Mi rol:</span>{' '}
    {rol}
  </p>

  {
    variante === 'destacado' && portada && (
      <Image
        src={portada}
        alt={portadaAlt ?? ''}
        widths={[480, 960]}
        sizes="(max-width: 768px) 100vw, 700px"
        class="mt-5 aspect-video w-full rounded-xl border border-line object-cover"
      />
    )
  }

  {
    metricas.length > 0 && (
      <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-line pt-4 sm:grid-cols-3">
        {metricas.map(({ valor, etiqueta }) => (
          <div>
            <dt class="sr-only">{etiqueta}</dt>
            <dd class="text-lg font-semibold tracking-tight text-accent">{valor}</dd>
            <p class="text-xs text-ink-soft">{etiqueta}</p>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="mt-4 flex flex-wrap gap-1.5">
    {
      herramientas.slice(0, 5).map((herramienta) => (
        <li class="rounded-md border border-line px-2 py-0.5 text-xs text-ink-soft">{herramienta}</li>
      ))
    }
  </ul>

  <p class="mt-5 text-sm font-medium text-link underline-offset-4 group-hover:underline">Ver case study →</p>
</article>
