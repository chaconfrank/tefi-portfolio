---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AvailabilityBadge from '../AvailabilityBadge.astro';
import { EMAIL, LINKEDIN, BUSCANDO_TRABAJO } from '../../consts';
import { cvPath, getLang, UI } from '../../i18n';

// Contacto, en los dos idiomas (src/pages/contacto.astro y
// src/pages/en/contact.astro).
const lang = getLang(Astro.url);
const ui = UI[lang];
const c = {
  es: {
    titulo: 'Contacto',
    descripcion: 'Email, LinkedIn y CV en PDF.',
    h1: '¿Cómo puedo ayudarte en tu próximo proyecto?',
    texto: 'Tanto si tienes una vacante definida como si sólo quieres contrastar una idea, escríbeme y le damos forma.',
    hablemos: 'Hablemos',
    ubicacion: 'Ubicación',
  },
  en: {
    titulo: 'Contact',
    descripcion: 'Email, LinkedIn and CV in PDF.',
    h1: 'How can I help with your next project?',
    texto: "Whether you have a defined role to fill or just want to test an idea, write to me and we'll shape it together.",
    hablemos: "Let's talk",
    ubicacion: 'Location',
  },
}[lang];

const canales = [
  { etiqueta: 'Email', valor: EMAIL, href: `mailto:${EMAIL}`, externo: false },
  {
    etiqueta: 'LinkedIn',
    valor: LINKEDIN.replace(/^https?:\/\/(www\.)?|\/$/g, ''),
    href: LINKEDIN,
    externo: true,
  },
  { etiqueta: c.ubicacion, valor: ui.ubicacion, href: null, externo: false },
];
---

<BaseLayout title={c.titulo} description={c.descripcion}>
  <section class="py-12">
    <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      {c.h1}
    </h1>
    <p class="mt-4 text-lg text-pretty text-ink-soft">{c.texto}</p>

    <!--
      Tarjeta de datos: los canales y el CTA al final. No hay formulario a
      propósito — el sitio es estático y un email directo llega antes que un
      formulario que nadie sabe si funciona.

      `relative` sin `overflow-hidden`: el sello va pegado como una pegatina en
      la esquina, y el desplazamiento negativo es justo la mitad de su tamaño
      para que quede medio dentro y medio fuera. Si cambias el tamaño, cambia
      el `-top-*` a la mitad exacta o deja de estar centrado en el borde.
    -->
    <div class="relative mt-16 rounded-2xl border border-line bg-paper-soft/40 p-6 sm:p-8">
      {
        BUSCANDO_TRABAJO && (
          <AvailabilityBadge clase="absolute -top-10 right-6 size-20 sm:-top-12 sm:right-8 sm:size-24" />
        )
      }

      <h2 class="text-xl font-semibold tracking-tight">{c.hablemos}</h2>

      <dl class="mt-6 divide-y divide-line border-y border-line">
        {
          canales.map(({ etiqueta, valor, href, externo }) => (
            <div class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <dt class="text-sm text-ink-soft">{etiqueta}</dt>
              <dd class="break-all sm:text-right">
                {href ? (
                  <a
                    class="underline-offset-4 transition hover:text-accent hover:underline"
                    href={href}
                    target={externo ? '_blank' : undefined}
                    rel={externo ? 'noopener' : undefined}
                  >
                    {valor}
                    {externo && ' ↗'}
                  </a>
                ) : (
                  <span>{valor}</span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <!-- Misma pareja que en el hero del inicio: primario con icono y
           outlined (borde + texto en primary) para el CV. -->
      <div class="mt-8 flex flex-wrap items-center gap-2.5">
        <a
          href={`mailto:${EMAIL}`}
          class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-paper transition hover:opacity-90"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          {ui.escribeme}
        </a>
        <a
          href={cvPath(lang)}
          class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-accent transition hover:border-accent/50 hover:bg-accent-soft"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M4 19h16" />
          </svg>
          {ui.descargarCvPdf}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
