---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="font-semibold tracking-tight">{SITE_TITLE}</a>

    <nav class="hidden gap-1 sm:flex" aria-label="Principal">
      {
        NAV_LINKS.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-1.5 text-sm transition hover:bg-paper-soft',
              isActive(href) ? 'text-ink font-medium' : 'text-ink-soft',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        class="rounded-lg border border-line p-2 text-ink-soft sm:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="nav-mobile" class="hidden border-t border-line px-6 py-3 sm:hidden" aria-label="Principal (móvil)">
    {
      NAV_LINKS.map(({ href, label }) => (
        <a href={href} class="block rounded-lg px-3 py-2 text-sm text-ink-soft hover:bg-paper-soft">
          {label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const button = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');

  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
  });
</script>
