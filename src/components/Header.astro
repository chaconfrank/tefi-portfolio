---
import NavPill from './NavPill.astro';
import ThemeToggle from './ThemeToggle.astro';
import { cvPath, equivalente, getLang, UI } from '../i18n';

const lang = getLang(Astro.url);
const ui = UI[lang];
const otro = lang === 'es' ? 'en' : 'es';
const hrefOtro = equivalente(Astro.url.pathname, otro);
---

<!--
  Header sin fondo propio: el halo teal de BaseLayout se ve a través. Los
  elementos con fondo usan la utilidad `glass` de global.css.
  Las columnas 1fr/auto/1fr centran la nav pase lo que pase a los lados.
-->
<header class="sticky top-0 z-50 py-3">
  <!--
    Sin avatar. En móvil, pastilla y controles en una fila centrada si caben;
    si no, los controles bajan a una segunda fila. En sm+ la rejilla
    1fr/auto/1fr centra la pastilla exactamente con los controles a la derecha.
  -->
  <div class="flex w-full flex-wrap items-center justify-center gap-2 px-4 sm:grid sm:grid-cols-[1fr_auto_1fr] sm:px-10">
    <!--
      El overflow-x-auto es SÓLO para móvil (la pastilla puede no caber): en
      sm+ tiene que ser visible — un scroller recorta el backdrop-blur del
      cristal en un rectángulo y sus esquinas asoman al hacer scroll.
    -->
    <div class="flex max-w-full justify-center overflow-x-auto sm:col-start-2 sm:w-auto sm:overflow-visible">
      <NavPill />
    </div>

    <div class="flex items-center gap-2 sm:col-start-3 sm:justify-self-end">
      <!--
        Cambio de idioma: un enlace con globo (no un toggle) a la misma página
        en el otro idioma. En móvil sólo el globo y el código del idioma.
      -->
      <a
        href={hrefOtro}
        hreflang={otro}
        lang={otro}
        aria-label={ui.cambiarIdiomaAria}
        class="glass inline-flex h-9.5 shrink-0 items-center gap-1.5 rounded-full px-3 text-sm font-medium text-ink-soft transition hover:bg-accent-soft hover:text-ink sm:h-10.5 sm:px-4"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18" />
        </svg>
        <span class="uppercase sm:hidden" aria-hidden="true">{otro}</span>
        <span class="hidden sm:inline" aria-hidden="true">{ui.cambiarIdioma}</span>
      </a>

      <ThemeToggle />

      <!--
        Acceso rápido al CV. Los tres controles (idioma, tema y CV) tienen la
        misma altura y el mismo cristal que la pastilla del menú (38 px en móvil,
        42 px desde sm). En
        móvil el CV es sólo el icono; el texto queda para lectores de pantalla.
      -->
      <a
        href={cvPath(lang)}
        aria-label={ui.descargarCv}
        class="glass inline-flex size-9.5 shrink-0 items-center justify-center gap-1.5 rounded-full text-sm font-medium whitespace-nowrap text-accent transition hover:bg-accent-soft sm:h-10.5 sm:w-auto sm:px-4"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12" />
          <path d="m7 10 5 5 5-5" />
          <path d="M4 19h16" />
        </svg>
        <span class="hidden sm:inline" aria-hidden="true">{ui.descargarCv}</span>
      </a>
    </div>
  </div>
</header>
