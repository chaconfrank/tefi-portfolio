---
import Avatar from './Avatar.astro';
import NavPill from './NavPill.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<!--
  Header sin fondo propio: el halo teal de BaseLayout se ve a través. Los
  elementos con fondo usan la utilidad `glass` de global.css.
  Las columnas 1fr/auto/1fr centran la nav pase lo que pase a los lados.
-->
<header class="sticky top-0 z-50 py-3">
  <div class="mx-auto grid w-full max-w-3xl grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 sm:px-6">
    <a href="/" class="col-start-1 justify-self-start" aria-label="Inicio">
      <Avatar />
    </a>

    <div class="col-start-2 overflow-x-auto">
      <NavPill />
    </div>

    <div class="col-start-3 justify-self-end">
      <ThemeToggle />
    </div>
  </div>
</header>
