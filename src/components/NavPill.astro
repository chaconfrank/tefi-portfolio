---
import { getLang, RUTAS, UI } from '../i18n';

// Nav en pastilla con efecto glass: el halo teal del fondo se ve a través.
const path = Astro.url.pathname;
const lang = getLang(Astro.url);
const enlaces = (['inicio', 'proyectos', 'sobreMi', 'contacto'] as const).map((clave, i) => ({
  href: RUTAS[clave][lang],
  label: UI[lang].nav[i],
}));
const inicio = RUTAS.inicio[lang];
const isActive = (href: string) => (href === inicio ? path === inicio : path.startsWith(href));
---

<nav class="glass flex w-max items-center gap-0.5 rounded-full p-1" aria-label={UI[lang].navAria}>
  {
    enlaces.map(({ href, label }) => (
      <a
        href={href}
        aria-current={isActive(href) ? 'page' : undefined}
        class:list={[
          'rounded-full px-2 py-1.5 text-xs whitespace-nowrap transition max-[25rem]:px-1.5 max-[23.5rem]:px-1 sm:px-3.5 sm:text-sm',
          isActive(href)
            ? 'bg-paper/90 text-ink font-medium shadow-sm'
            : 'text-ink-soft hover:text-ink',
        ]}
      >
        {label}
      </a>
    ))
  }
</nav>
