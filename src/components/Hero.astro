---
import {
  SITE_AUTHOR,
  SITE_ROLE,
  SITE_TAGLINE,
  UBICACION,
  CV_PATH,
  EMAIL,
  BUSCANDO_TRABAJO,
  DISPONIBILIDAD,
} from '../consts';
---

<section class="pt-10 pb-12 sm:pt-16 sm:pb-16">
  {
    BUSCANDO_TRABAJO && (
      <p class="glass inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs text-ink-soft">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500/70" />
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
        </span>
        {DISPONIBILIDAD} · {UBICACION}
      </p>
    )
  }

  <h1 class="mt-5 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
    {SITE_AUTHOR}
    <span class="mt-1 block text-2xl font-normal text-ink-soft sm:text-3xl">{SITE_ROLE}</span>
  </h1>

  <p class="mt-5 max-w-lg text-base leading-relaxed text-pretty sm:text-lg">
    {SITE_TAGLINE}{' '}
    <span class="text-ink-soft">
      Traduzco necesidades complejas en interfaces intuitivas, respaldadas por
      sistemas de diseño y decisiones basadas en datos.
    </span>
  </p>

  <!-- Un único CTA primario: el resto son secundarios y no compiten. -->
  <div class="mt-8 flex flex-wrap items-center gap-2.5">
    <a
      href="/proyectos/"
      class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition hover:opacity-90"
    >
      Ver los 3 case studies
    </a>
    <a href={CV_PATH} class="glass rounded-full px-5 py-2.5 text-sm font-medium transition hover:bg-paper/70">
      Descargar CV
    </a>
    <a
      href={`mailto:${EMAIL}`}
      class="px-2 text-sm text-ink-soft underline-offset-4 transition hover:text-ink hover:underline"
    >
      Escríbeme
    </a>
  </div>
</section>
