---
import { SITE_AUTHOR, SITE_ROLE, EMAIL, BUSCANDO_TRABAJO } from '../consts';
import { cvPath, getLang, ruta, UI } from '../i18n';

const lang = getLang(Astro.url);
const ui = UI[lang];
const complemento =
  lang === 'es'
    ? 'Con sistemas de diseño que sostienen el producto y un proceso que conecta diseño y desarrollo.'
    : 'With design systems that hold the product together and a process that connects design and development.';
---

<!--
  Una sola columna: el párrafo va debajo del nombre y el rol, no al lado (se
  probó a dos columnas y se descartó). Poca altura a propósito: el abanico de
  proyectos tiene que asomar en la primera pantalla.
-->
<section class="pt-8 pb-6 sm:pt-12 sm:pb-8">
  {
    BUSCANDO_TRABAJO && (
      <p class="glass-strong inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs text-ink">
        <!-- Verde «disponible» (--color-online): contrasta solo, sin aro. -->
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-online" />
          <span class="relative inline-flex size-2 rounded-full bg-online" />
        </span>
        {ui.disponibilidad} · {ui.ubicacion}
      </p>
    )
  }

  <h1 class="mt-5 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
    {SITE_AUTHOR}
    <span class="mt-1 block text-2xl font-normal text-ink-soft sm:text-3xl">{SITE_ROLE}</span>
  </h1>

  <p class="mt-5 text-base leading-relaxed text-pretty sm:text-lg">
    {ui.tagline}{' '}
    <span class="text-ink-soft">{complemento}</span>
  </p>

  <!-- Un único CTA primario: el resto son secundarios y no compiten.
       Los tres llevan icono; «Descargar CV» es un outlined (borde + texto en
       primary, sin relleno). -->
  <div class="mt-8 flex flex-wrap items-center gap-2.5">
    <a
      href={ruta(lang, 'proyectos')}
      class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-paper transition hover:opacity-90"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </svg>
      {ui.verProyectos}
    </a>
    <a
      href={cvPath(lang)}
      class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-accent transition hover:border-accent/50 hover:bg-accent-soft"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12" />
        <path d="m7 10 5 5 5-5" />
        <path d="M4 19h16" />
      </svg>
      {ui.descargarCv}
    </a>
    <a
      href={`mailto:${EMAIL}`}
      class="inline-flex items-center gap-2 px-2 text-sm text-ink-soft underline-offset-4 transition hover:text-ink hover:underline"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
      {ui.escribeme}
    </a>
  </div>
</section>
