---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { titulo, descripcion, portada, portadaAlt, stack, repo, demo, fecha } =
  proyecto.data;
---

<BaseLayout title={titulo} description={descripcion}>
  <article class="py-12">
    <a href="/proyectos" class="text-sm text-ink-soft transition hover:text-ink">← Proyectos</a>

    <h1 class="mt-6 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{titulo}</h1>
    <p class="mt-3 text-lg text-pretty text-ink-soft">{descripcion}</p>

    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-soft">
      <FormattedDate date={fecha} />
      {demo && <a class="text-accent hover:underline" href={demo} target="_blank" rel="noopener">Ver demo ↗</a>}
      {repo && <a class="text-accent hover:underline" href={repo} target="_blank" rel="noopener">Código ↗</a>}
    </div>

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {stack.map((tech) => <li class="rounded-md border border-line px-2 py-0.5 text-xs text-ink-soft">{tech}</li>)}
    </ul>

    {
      portada && (
        <Image src={portada} alt={portadaAlt ?? ''} class="mt-8 w-full rounded-2xl border border-line" />
      )
    }

    <div class="prose-portfolio mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Necesario en Tailwind v4 para usar @apply dentro de un <style> de componente */
  @reference "../styles/global.css";

  /* Estilos del contenido Markdown. Si prefieres, sustitúyelo por @tailwindcss/typography. */
  .prose-portfolio :global(h2) {
    @apply mt-10 mb-3 text-xl font-semibold tracking-tight;
  }
  .prose-portfolio :global(h3) {
    @apply mt-8 mb-2 font-medium;
  }
  .prose-portfolio :global(p) {
    @apply my-4 leading-relaxed text-pretty text-ink-soft;
  }
  .prose-portfolio :global(ul) {
    @apply my-4 list-disc space-y-1.5 pl-5 text-ink-soft;
  }
  .prose-portfolio :global(a) {
    @apply text-accent underline underline-offset-2;
  }
  .prose-portfolio :global(pre) {
    @apply my-6 overflow-x-auto rounded-xl border border-line p-4 text-sm;
  }
  .prose-portfolio :global(img) {
    @apply my-6 rounded-xl;
  }
</style>
