---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import MetricStrip from '../components/MetricStrip.astro';
import ContactCTA from '../components/ContactCTA.astro';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  siguiente?: CollectionEntry<'proyectos'>;
}

const { proyecto, siguiente } = Astro.props;
const {
  titulo,
  descripcion,
  tipo,
  rol,
  periodo,
  equipo,
  herramientas,
  metricas,
  aprendizaje,
  portada,
  portadaAlt,
  demo,
  repo,
} = proyecto.data;

// Ficha de cabecera: lo que un recruiter mira antes de decidir si sigue leyendo.
const ficha = [
  { etiqueta: 'Mi rol', valor: rol },
  { etiqueta: 'Periodo', valor: periodo },
  { etiqueta: 'Equipo', valor: equipo },
  { etiqueta: 'Herramientas', valor: herramientas.join(' · ') },
].filter((item): item is { etiqueta: string; valor: string } => Boolean(item.valor));
---

<BaseLayout title={titulo} description={descripcion}>
  <article class="py-12">
    <a href="/proyectos/" class="text-sm text-ink-soft transition hover:text-ink">← Proyectos</a>

    <p class="mt-6 flex items-center gap-3 text-xs text-ink-soft">
      <span class="rounded-md border border-line bg-paper-soft px-2 py-0.5 font-medium text-ink">{tipo}</span>
      <span>{periodo}</span>
    </p>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{titulo}</h1>
    <p class="mt-4 max-w-2xl text-lg text-pretty text-ink-soft">{descripcion}</p>

    {
      (demo || repo) && (
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          {demo && (
            <a class="text-accent hover:underline" href={demo} target="_blank" rel="noopener">
              Ver proyecto ↗
            </a>
          )}
          {repo && (
            <a class="text-accent hover:underline" href={repo} target="_blank" rel="noopener">
              Repositorio ↗
            </a>
          )}
        </div>
      )
    }

    {
      portada && (
        <Image
          src={portada}
          alt={portadaAlt ?? ''}
          widths={[720, 1440]}
          sizes="(max-width: 768px) 100vw, 720px"
          class="mt-8 aspect-video w-full rounded-2xl border border-line object-cover"
        />
      )
    }

    <dl class="mt-10 grid gap-x-8 gap-y-5 border-y border-line py-6 sm:grid-cols-2">
      {
        ficha.map(({ etiqueta, valor }) => (
          <div>
            <dt class="text-xs tracking-wide text-ink-soft uppercase">{etiqueta}</dt>
            <dd class="mt-1 text-sm text-pretty">{valor}</dd>
          </div>
        ))
      }
    </dl>

    {
      metricas.length > 0 && (
        <div class="mt-10">
          <h2 class="mb-4 text-sm font-medium tracking-wide text-ink-soft uppercase">Impacto</h2>
          <MetricStrip metricas={metricas} />
        </div>
      )
    }

    <div class="prose-portfolio mt-6">
      <slot />
    </div>

    <aside class="mt-12 rounded-2xl border border-accent/30 bg-accent/5 p-6">
      <h2 class="text-sm font-medium tracking-wide text-accent uppercase">Aprendizaje clave</h2>
      <p class="mt-2 text-lg text-pretty">{aprendizaje}</p>
    </aside>

    {
      siguiente && (
        <nav class="mt-12 border-t border-line pt-6">
          <p class="text-xs tracking-wide text-ink-soft uppercase">Siguiente case study</p>
          <a
            href={`/proyectos/${siguiente.id}/`}
            class="mt-2 block text-xl font-semibold tracking-tight text-balance transition hover:text-accent"
          >
            {siguiente.data.titulo} →
          </a>
        </nav>
      )
    }
  </article>

  <ContactCTA />
</BaseLayout>

<style>
  /* Necesario en Tailwind v4 para usar @apply dentro de un <style> de componente */
  @reference "../styles/global.css";

  /* Estilado del Markdown renderizado. Va con :global() porque el HTML de
     <Content /> no lleva el atributo de scope de este layout. */
  .prose-portfolio :global(h2) {
    @apply mt-12 mb-4 border-t border-line pt-6 text-xl font-semibold tracking-tight text-ink;
  }
  .prose-portfolio :global(h3) {
    @apply mt-8 mb-2 font-medium text-ink;
  }
  .prose-portfolio :global(p) {
    @apply my-4 leading-relaxed text-pretty text-ink-soft;
  }
  .prose-portfolio :global(ul) {
    @apply my-4 list-disc space-y-2 pl-5 text-ink-soft marker:text-accent;
  }
  .prose-portfolio :global(ol) {
    @apply my-4 list-decimal space-y-2 pl-5 text-ink-soft marker:text-ink-soft;
  }
  .prose-portfolio :global(strong) {
    @apply font-medium text-ink;
  }
  .prose-portfolio :global(blockquote) {
    @apply my-6 border-l-2 border-accent/50 pl-4 text-pretty text-ink-soft italic;
  }
  .prose-portfolio :global(a) {
    @apply text-accent underline underline-offset-2;
  }
  .prose-portfolio :global(pre) {
    @apply my-6 overflow-x-auto rounded-xl border border-line p-4 text-sm;
  }
  .prose-portfolio :global(img) {
    @apply my-6 rounded-xl border border-line;
  }
  .prose-portfolio :global(hr) {
    @apply my-10 border-line;
  }
</style>
