---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CaseNav from '../components/case-study/CaseNav.astro';
import { getLang, hrefProyecto, slugDe, UI } from '../i18n';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  siguiente?: CollectionEntry<'proyectos'>;
}

const { proyecto, siguiente } = Astro.props;
const { titulo, descripcion } = proyecto.data;
const lang = getLang(Astro.url);
// Vista previa en redes: la portada del caso centrada en 1200×630, generada
// en public/og/<slug>.jpg (ver assets.md). Si cambia la portada, regenérala.
const imagenSocial = `/og/${slugDe(proyecto)}.jpg`;
---

<!--
  Case study editorial: a diferencia de ProjectLayout no pinta cabecera ni
  estila Markdown. El cuerpo MDX compone la maqueta entera con los
  componentes de src/components/case-study/, cada sección con su propio
  ritmo. Aquí sólo queda el marco común: título de página, índice de
  capítulos (CaseNav), siguiente caso y cierre.
-->
<BaseLayout title={titulo} description={descripcion} image={imagenSocial}>
  <article>
    <slot />
  </article>

  <CaseNav />

  {
    siguiente && (
      <nav class="mx-auto mt-24 max-w-6xl border-t border-line pt-8">
        <p class="text-xs font-medium tracking-[0.14em] text-ink-soft uppercase">{UI[lang].siguienteCaso}</p>
        <a
          href={hrefProyecto(lang, slugDe(siguiente))}
          class="mt-2 block text-xl font-semibold tracking-tight text-balance transition hover:text-accent sm:text-2xl"
        >
          {siguiente.data.titular ?? siguiente.data.titulo} →
        </a>
      </nav>
    )
  }

  <ContactCTA />
</BaseLayout>
