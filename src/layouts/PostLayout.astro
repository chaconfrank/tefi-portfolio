---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article class="py-12">
    <a href="/blog" class="text-sm text-ink-soft transition hover:text-ink">← Blog</a>

    <h1 class="mt-6 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>

    <p class="mt-3 text-sm text-ink-soft">
      <FormattedDate date={pubDate} />
      {updatedDate && <> · actualizado el <FormattedDate date={updatedDate} /></>}
    </p>

    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="rounded-md border border-line px-2 py-0.5 text-xs text-ink-soft">#{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="prose-portfolio mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Necesario en Tailwind v4 para usar @apply dentro de un <style> de componente */
  @reference "../styles/global.css";

  .prose-portfolio :global(h2) {
    @apply mt-10 mb-3 text-xl font-semibold tracking-tight;
  }
  .prose-portfolio :global(h3) {
    @apply mt-8 mb-2 font-medium;
  }
  .prose-portfolio :global(p) {
    @apply my-4 leading-relaxed text-pretty text-ink-soft;
  }
  .prose-portfolio :global(ul) {
    @apply my-4 list-disc space-y-1.5 pl-5 text-ink-soft;
  }
  .prose-portfolio :global(a) {
    @apply text-accent underline underline-offset-2;
  }
  .prose-portfolio :global(pre) {
    @apply my-6 overflow-x-auto rounded-xl border border-line p-4 text-sm;
  }
</style>
